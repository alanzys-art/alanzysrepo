<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <application android:label="أذكاري TV" android:theme="@android:style/Theme.Material.NoActionBar" android:usesCleartextTraffic="false" android:banner="@drawable/banner" android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="landscape">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent-filter>
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <service android:name=".AdhkarDreamService" android:exported="true" android:permission="android.permission.BIND_DREAM_SERVICE" android:label="أذكاري TV">
            <intent-filter><action android:name="android.service.dreams.DreamService" /></intent-filter>
        </service>
    </application>
</manifest>
